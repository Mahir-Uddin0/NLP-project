PROJECT_NAME="NLP Suite API"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://your-frontend-domain.vercel.app"]

# Groq API Key for STT (Whisper Large v3 / Turbo)
GROQ_API_KEY=

# ElevenLabs API Key for TTS (Optional)
ELEVENLABS_API_KEY=

# Gemini API Key for Question Answering & Chatbot
GEMINI_API_KEY=

# MyMemory Direct API Endpoint (No API key / credentials required)
MYMEMORY_API_URL=https://api.mymemory.translated.net/get

# MyMemory Translation Registered Email (Optional, provides 50,000 words/day free limit)
MYMEMORY_EMAIL=

